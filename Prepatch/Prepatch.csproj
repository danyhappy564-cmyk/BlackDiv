<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net471</TargetFramework>
    <AssemblyName>BlackDiv</AssemblyName>
    <Description>BlackDiv Prepatch needed to add custom bots to the client.</Description>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <LangVersion>latest</LangVersion>
    <Configurations>Debug;Release</Configurations>
    <RootNamespace>BlackDiv</RootNamespace>
    <!-- overridable per-machine with -p:SptRoot=... (or an SptRoot environment
         variable) - was a set of relative ..\..\..\ paths tied to one specific
         folder depth, so a checkout anywhere else couldn't resolve the game
         assemblies at all. -->
    <SptRoot Condition="'$(SptRoot)' == ''">E:\SPT 4.0.10</SptRoot>
  </PropertyGroup>

  <ItemGroup>
		<Reference Include="Assembly-CSharp">
		  <HintPath>$(SptRoot)\EscapeFromTarkov_Data\Managed\Assembly-CSharp.dll</HintPath>
		</Reference>
		<Reference Include="MoreBotsPrepatch">
		  <HintPath>..\Reference\MoreBotsPrepatch.dll</HintPath>
		</Reference>
		<Reference Include="spt-common">
		  <HintPath>$(SptRoot)\BepInEx\plugins\spt\spt-common.dll</HintPath>
		</Reference>
    <Reference Include="0Harmony">
      <HintPath>$(SptRoot)\BepInEx\core\0Harmony.dll</HintPath>
    </Reference>
    <Reference Include="BepInEx">
      <HintPath>$(SptRoot)\BepInEx\core\BepInEx.dll</HintPath>
    </Reference>
    <Reference Include="Mono.Cecil">
      <HintPath>$(SptRoot)\BepInEx\core\Mono.Cecil.dll</HintPath>
    </Reference>
		<Reference Include="Newtonsoft.Json">
		  <HintPath>$(SptRoot)\EscapeFromTarkov_Data\Managed\Newtonsoft.Json.dll</HintPath>
		</Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(SptRoot)\EscapeFromTarkov_Data\Managed\UnityEngine.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(SptRoot)\EscapeFromTarkov_Data\Managed\UnityEngine.CoreModule.dll</HintPath>
    </Reference>
  </ItemGroup>

  <Target Name="PostBuild" AfterTargets="PostBuildEvent">
    <MakeDir Directories="$(SptRoot)\BepInEx\patchers" />
    <Exec Command="copy /Y &quot;$(TargetPath)&quot; &quot;$(SptRoot)\BepInEx\patchers\$(TargetFileName)&quot;" />
  </Target>

</Project>